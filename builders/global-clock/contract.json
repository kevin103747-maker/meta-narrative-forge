    "target_files": [
      "builders/global-clock/index.js"
    ]
  },
  "interfaces": {
    "inputs": {
      "initialize(config)": "{ startHour: number, tickDurationHours: number } - 시계 초기화",
      "advance(ticks)": "지정된 틱 수만큼 시간 전진",
      "registerCharacter(characterId)": "캐릭터 등록 (로컬 시간 추적 시작)",
      "adjustLocalTime(characterId, deltaHours)": "캐릭터의 로컬 시간 수동 조정 (이동/행동 시 사용)",
      "getCurrentTime()": "현재 글로벌 시간 반환",
      "getLocalTime(characterId)": "캐릭터의 로컬 시간 반환",
      "getElapsedTime(characterId)": "캐릭터가 경험한 총 시간 반환",
      "createSnapshot(label)": "현재 시간 상태 스냅샷 생성",
      "restoreSnapshot(snapshotId)": "스냅샷으로 시간 상태 복원"
    },
    "outputs": {
      "globalTime": "number - 현재 글로벌 시간 (시간 단위)",
      "localTime": "number - 캐릭터별 로컬 시간 (시간 단위)",
      "snapshot": "{ id, label, globalTime, localTimes, timestamp } - 시간 상태 스냅샷"
    }
  },
